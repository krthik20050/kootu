APP_ENV=development
FRONTEND_URL=http://localhost:3000
# Server-only PostgreSQL connection. Apply migrations first. Never use a browser anon role.
DATABASE_URL=
# Exact Clerk instance HTTPS origin, e.g. https://your-instance.clerk.accounts.dev
CLERK_ISSUER=
CLERK_AUDIENCE=
# Clerk user ID for the first operator; keep server-only and remove after provisioning roles.
BOOTSTRAP_ADMIN_SUBJECT=
GOOGLE_MAPS_API_KEY=
GROK_API_KEY=
# Choose an account-supported model with vision and structured outputs.
GROK_MODEL=
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
AVIATIONSTACK_API_KEY=
FLIGHT_POLL_SECONDS=900
CLUSTER_RADIUS_METRES=3000
MAX_GROUP_SEATS=4
MAX_GROUP_LUGGAGE=4
OFFER_TTL_SECONDS=300
