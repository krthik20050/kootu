# Browser-safe. Local API base URL; use the Render HTTPS URL for deployment.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Disabled for the keyless public preview. Enable to use booking with real Clerk keys.
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only. Never prefix this with NEXT_PUBLIC_.
CLERK_SECRET_KEY=
# Private address autocomplete key; sync to backend.
GEOAPIFY_API_KEY=""
